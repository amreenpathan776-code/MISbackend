      FROM UsersInfo
      WHERE UserId = @userId
    `);

  if (!userInfo.recordset.length) {
  logWarn("User not found in DB");
    return res.status(403).json({ message: "User not found" });
  }

  const { Role } = userInfo.recordset[0];
  logInfo("User role", Role);

