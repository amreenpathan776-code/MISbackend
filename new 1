      type === "CALL"
        ? `
        SELECT
          CRS.LoanAccountNumber,
          R.firstname,
          R.mobileNumber,
          R.currentOutstandingBalance AS overdueAmount,
          R.dpdQueue,

          ISNULL(CRS.ScheduleCallPendingFlag,0)   AS ScheduleCallPendingFlag,
