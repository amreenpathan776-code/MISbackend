});

if (userName) {
  logInfo("Filter applied: userName", userName);
}
    request.input("UserName", sql.VarChar, userName || "");

    let finalCluster = cluster;
    let finalBranch = branch;

    // 🔒 Branch Manager restriction
    if (role === "Branch Manager") {
