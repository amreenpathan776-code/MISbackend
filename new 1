    AND (@Type IS NULL OR @Type='ALL' OR @Type='CO_USE')
    AND (
        @SearchText IS NULL
        OR sr.[Account Name] LIKE '%' + @SearchText + '%'
        OR s.LoanAccountNumber LIKE '%' + @SearchText + '%'
    )


ORDER BY ActionTime DESC
      `);
