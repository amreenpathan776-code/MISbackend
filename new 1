WHERE
    s.StartedByUserId = @UserId
    AND (
        (@FromDate IS NULL OR CAST(l.CreatedAt AS DATE) >= @FromDate)
        AND (@ToDate IS NULL OR CAST(l.CreatedAt AS DATE) <= @ToDate)
